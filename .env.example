# DataSense AI Environment Variables Configuration

# Application Metadata
APP_NAME=DataSense AI
APP_ENV=development
API_VERSION=1.0.0
SECRET_KEY=datasense_ai_super_secret_production_key_change_me_12345

# Database Configuration (PostgreSQL or SQLite)
DATABASE_URL=sqlite:///./datasense.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://datasense_user:datasense_pass@db:5432/datasense_db

# MLflow Experiment Tracking Server
MLFLOW_TRACKING_URI=http://mlflow:5000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8501", "http://127.0.0.1:8501"]

# Application Logging
LOG_LEVEL=INFO
