# General Application Settings
APP_NAME="DataSense AI"
APP_ENV="development"
DEBUG=True
API_VERSION="v1"
SECRET_KEY="change-this-in-production-use-a-strong-random-secret"

# FastAPI Server Settings
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501","http://127.0.0.1:8501"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="datasense_user"
POSTGRES_PASSWORD="datasense_password"
POSTGRES_DB="datasense_db"
DATABASE_URL="postgresql://datasense_user:datasense_password@localhost:5432/datasense_db"
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=False

# Streamlit Dashboard Settings
STREAMLIT_SERVER_PORT=8501
BACKEND_API_URL="http://localhost:8000"

# MLflow Experiment Tracking Settings
MLFLOW_TRACKING_URI="sqlite:///mlflow.db"
MLFLOW_EXPERIMENT_NAME="DataSense_AI_Default"

# Logging Settings
LOG_LEVEL="INFO"
LOG_FORMAT="json"
